{
  "redirects": [
    {
      "source": "/what-we-do",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/what-we-do/(.*)",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/where-we-work",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/who-we-are",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/clients",
      "destination": "/case-studies",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|cohere-ai|meta-externalagent|Amazonbot|CCBot|Bytespider).*"
        }
      ],
      "destination": "/snapshots/index.html"
    },
    {
      "source": "/(services|case-studies)/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|cohere-ai|meta-externalagent|Amazonbot|CCBot|Bytespider).*"
        }
      ],
      "destination": "/snapshots/$1/$2.html"
    },
    {
      "source": "/(services|case-studies|about|contact|faq)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|anthropic-ai|PerplexityBot|Perplexity-User|cohere-ai|meta-externalagent|Amazonbot|CCBot|Bytespider).*"
        }
      ],
      "destination": "/snapshots/$1.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
